{
  "name": "go-package-view",
  "displayName": "Go Package View",
  "description": "Explore Go package dependencies and search across all dependency source files",
  "version": "0.2.1",
  "publisher": "wittwitt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wittwitt/vscode_go_package_view.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onView:goPackageView",
    "onCommand:goPackageView.searchDependencies"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "goPackageView",
          "name": "Go Packages"
        }
      ]
    },
    "configuration": {
      "title": "Go Package View",
      "properties": {
        "goPackageView.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Auto-refresh dependency tree when go.mod or source files change"
        },
        "goPackageView.maxDepth": {
          "type": "number",
          "default": 0,
          "description": "Max depth for tree expansion (0 = unlimited)"
        }
      }
    },
    "commands": [
      {
        "command": "goPackageView.refresh",
        "title": "Refresh Go Packages",
        "category": "Go Package View",
        "icon": "$(refresh)"
      },
      {
        "command": "goPackageView.searchDependencies",
        "title": "Search All Dependencies",
        "category": "Go Package View",
        "icon": "$(search)"
      },
      {
        "command": "goPackageView.copyImportPath",
        "title": "Copy Import Path"
      },
      {
        "command": "goPackageView.openInTerminal",
        "title": "Open in Terminal"
      },
      {
        "command": "goPackageView.revealFileInOS",
        "title": "Reveal in Finder"
      },
      {
        "command": "goPackageView.newFile",
        "title": "New File"
      },
      {
        "command": "goPackageView.newSubdirectory",
        "title": "New Subdirectory"
      },
      {
        "command": "goPackageView.deleteFolder",
        "title": "Delete Folder"
      }
    ],
    "keybindings": [
      {
        "command": "goPackageView.searchDependencies",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "goPackageView.searchDependencies",
          "when": "view == goPackageView",
          "group": "navigation@1"
        },
        {
          "command": "goPackageView.refresh",
          "when": "view == goPackageView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "view": "goPackageView",
          "when": "viewItem == goPackage",
          "command": "goPackageView.copyImportPath",
          "group": "1_copy"
        },
        {
          "view": "goPackageView",
          "when": "viewItem == goPackage",
          "command": "goPackageView.openInTerminal",
          "group": "2_terminal"
        },
        {
          "view": "goPackageView",
          "when": "viewItem == goFile",
          "command": "goPackageView.revealFileInOS",
          "group": "navigation"
        },
        {
          "view": "goPackageView",
          "when": "viewItem == goPackage",
          "command": "goPackageView.newFile",
          "group": "3_new_file"
        },
        {
          "view": "goPackageView",
          "when": "viewItem == goPackage",
          "command": "goPackageView.newSubdirectory",
          "group": "4_new_dir"
        },
        {
          "view": "goPackageView",
          "when": "viewItem == goPackage",
          "command": "goPackageView.deleteFolder",
          "group": "5_delete"
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
